[Unit]
Description=Probe server monitoring agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=probe-agent
Group=probe-agent
EnvironmentFile=/etc/probe-agent/agent.env
ExecStart=/opt/probe-agent/venv/bin/python /opt/probe-agent/agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/proc /sys
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

