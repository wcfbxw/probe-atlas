# Dashboard
NEXT_PUBLIC_PROBE_API_URL=http://127.0.0.1:8080

# Docker production deployment (normally generated by deploy/install-server.sh)
SITE_ADDRESS=monitor.example.com
PUBLIC_URL=https://monitor.example.com
PANEL_USERNAME=admin
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
PANEL_PASSWORD_HASH=$2a$14$replace.with.a.real.caddy.password.hash

# Control server
HOST=0.0.0.0
PORT=8080
DATA_DIR=.data
STATUS_TTL_MS=10000
OFFLINE_SWEEP_MS=5000
DASHBOARD_BATCH_MS=1000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production must replace these with independent random tokens.
AGENT_TOKENS_JSON={"vps-us-01":"replace-with-at-least-32-random-bytes","vps-hk-01":"replace-with-another-random-secret"}

# Optional production services
REDIS_URL=
WEBHOOK_URL=
WEBHOOK_SECRET=
